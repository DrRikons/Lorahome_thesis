          "getPayload": "const recentValue = (name, maxAge) => {\n  const frame = context.panel.data.series.find(s => s.fields.some(f => f.name === name));\n  const valueField = frame?.fields.find(f => f.name === name);\n  const timeField = frame?.fields.find(f => f.type === 'time' || f.name === '_time');\n  const value = valueField?.values?.get?.(valueField.values.length-1) ?? valueField?.values?.[valueField.values.length-1];\n  const at = timeField?.values?.get?.(timeField.values.length-1) ?? timeField?.values?.[timeField.values.length-1];\n  const age = Date.now() - Number(at);\n  return Number.isFinite(age) && age >= -30000 && age <= maxAge ? value : undefined;\n};\nconst devEligible = () => recentValue('sensorOnline',300000) === true && recentValue('sensorDevMode',900000) === 1 && recentValue('gatewayFresh',300000) !== undefined;\nconst sensor=context.grafana.templateService.replace('${sensor_id}');\nif(localStorage.getItem('lorahome-sensor-settings:'+sensor))throw Error('Previous Sensor command is unresolved; inspect or acknowledge it first');\nconst initial=context.panel.initial||{}, fields=['defaultSleepSeconds','defaultDevMode','defaultTxPower','defaultCpuFrequencyMhz'];\nconst output={};\nfor(const name of fields){const element=context.panel.elements.find(e=>e.id===name);const old=initial[name];if(!element)continue;if(old===undefined||old===null){if(name==='defaultCpuFrequencyMhz')continue;throw Error('Current Sensor settings unavailable');}if(element.value!==old)output[name]=element.value;}\nif('defaultCpuFrequencyMhz' in output){if(!devEligible()||!Number.isInteger(recentValue('defaultCpuFrequencyMhz',900000)))throw Error('CPU changes require recent online Development-mode and CPU telemetry');if('defaultDevMode' in output)throw Error('Submit the mode change separately and wait for confirmation before changing CPU');}\nconst sleepMinimum = () => {\n  const frame = context.panel.data.series.find(s => s.refId === 'F' && s.fields.some(f => f.name === 'radio_available'));\n  const field = name => { const f = frame?.fields.find(x => x.name === name); return f?.values?.get?.(f.values.length - 1) ?? f?.values?.[f.values.length - 1]; };\n  const age = Date.now() - Number(field('_time'));\n  const sf = field('radio_spreading_factor'), bw = field('radio_bandwidth_khz'), cr = field('radio_coding_rate');\n  if (!Number.isFinite(age) || age < -30000 || age > 300000 || field('radio_available') !== true || !Number.isInteger(sf) || sf < 7 || sf > 12 || ![7.8,10.4,15.6,20.8,31.25,41.7,62.5,125,250,500].includes(bw) || !Number.isInteger(cr) || cr < 5 || cr > 8) return undefined;\n  const currentMode = recentValue('sensorDevMode', 900000);\n  const mode = context.panel.elements?.find(e => e.id === 'defaultDevMode');\n  const selectedMode = context.element?.id === 'defaultDevMode' ? context.element.value : mode?.value;\n  if ((currentMode !== 0 && currentMode !== 1) || typeof selectedMode !== 'boolean') return undefined;\n  const air = bytes => { const t = Math.pow(2, sf) / (bw * 1000), de = t >= 0.016 ? 1 : 0; return (12.25 + 8 + Math.max(Math.ceil((8 * bytes - 4 * sf + 44) / (4 * (sf - 2 * de))) * cr, 0)) * t; };\n  return Math.max(10, Math.ceil(99 * Math.max(air(selectedMode || currentMode === 1 ? 45 : 34), air(10))));\n};\nif ('defaultSleepSeconds' in output || 'defaultDevMode' in output) {\n  const minimum = sleepMinimum();\n  if (minimum === undefined) throw Error('Recent confirmed Sensor radio profile and mode required to validate sleep');\n  if (minimum > 255) throw Error('Minimum sleep for this radio profile exceeds 255 seconds');\n  const sleep = context.panel.elements.find(e => e.id === 'defaultSleepSeconds')?.value;\n  if (!Number.isInteger(sleep) || sleep < minimum || sleep > 255) throw Error(`Sleep must be between ${minimum} and 255 seconds for the current radio profile and mode`);\n}\nif(!Object.keys(output).length)throw Error('No changed Sensor settings');return output;",
