          "query": "import \"internal/debug\"\nlink = from(bucket: \"{{ influxdb_bucket }}\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"sensor_status\" and r.sensor_id == \"${sensor_id}\") |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\") |> group(columns: [\"sensor_id\"])\nrssi = link |> map(fn: (r) => ({_time: r._time, _field: \"Uplink RSSI (dBm)\", _value: if exists r.sensor_radio_present then (if exists r.sensor_radio_uplink_rssi_dbm then float(v: r.sensor_radio_uplink_rssi_dbm) else debug.null(type: \"float\")) else if exists r.link_rssi_dbm then float(v: r.link_rssi_dbm) else debug.null(type: \"float\")}))\nsnr = link |> map(fn: (r) => ({_time: r._time, _field: \"Uplink SNR (dB)\", _value: if exists r.sensor_radio_present then (if exists r.sensor_radio_uplink_snr_db then float(v: r.sensor_radio_uplink_snr_db) else debug.null(type: \"float\")) else if exists r.link_snr_db then float(v: r.link_snr_db) else debug.null(type: \"float\")}))\npower = from(bucket: \"{{ influxdb_bucket }}\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"sensor_reading\" and r.sensor_id == \"${sensor_id}\" and r._field == \"txPower\") |> map(fn: (r) => ({_time: r._time, _field: \"Sensor TX power (dBm)\", _value: float(v: r._value)}))\nunion(tables: [rssi, snr, power]) |> group(columns: [\"_field\"]) |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false) |> keep(columns: [\"_time\", \"_value\", \"_field\"])",
