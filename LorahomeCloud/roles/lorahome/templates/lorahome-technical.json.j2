(bw * 1000), de = t >= 0.016 ? 1 : 0; return (12.25 + 8 + Math.max(Math.ceil((8 * bytes - 4 * sf + 44) / (4 * (sf - 2 * de))) * cr, 0)) * t; };\n  return Math.max(10, Math.ceil(99 * Math.max(air(selectedMode || currentMode === 1 ? 45 : 34), air(10))));\n};\nconst minimum = sleepMinimum();\nif (context.panel.onChangeElements && context.panel.elements) context.panel.onChangeElements(context.panel.elements.map(e => {\n  const value = context.element?.id === e.id ? context.element.value : e.value;\n  if (e.id === 'defaultSleepSeconds') return {...e, value, min: minimum === undefined ? 10 : minimum};\n  if (e.id === 'sleepMinimumStatus') return {...e, value: minimum === undefined ? 'Unavailable: recent radio profile and mode required' : minimum > 255 ? 'Unavailable: minimum exceeds 255 seconds' : `Minimum: ${minimum} s`};\n  return context.element?.id === e.id ? {...e, value} : e;\n}));\nconst cpu = recentValue('defaultCpuFrequencyMhz',900000);\ncontext.panel.patchFormValue({sensorModeStatus: devEligible() && Number.isInteger(cpu) ? 'Development confirmed' : 'CPU unavailable: confirm online Development mode and recent CPU telemetry'});\nconst sensor=context.grafana.templateService.replace('${sensor_id}');\nconst id=localStorage.getItem('lorahome-sensor-settings:'+sensor);\nif(!id){context.panel.patchFormValue({sensorCommandStatus:'No command pending'});context.panel.enableSubmit();return;}\ncontext.panel.disableSubmit();\nconst base=context.grafana.templateService.replace(context.panel.options.update.url).replace(/\\/config$/, '');\nconst auth=context.panel.options.update.header.find(h=>h.name==='Authorization')?.value;\nreturn fetch(base+'/commands/'+encodeURIComponent(id),{headers:{Authorization:auth},cache:'no-store'}).then(r=>r.ok?r.json():Promise.reject(Error('Status unavailable'))).then(result=>{\n if(result.status==='applied'){localStorage.removeItem('lorahome-sensor-settings:'+sensor);context.panel.patchFormValue({sensorCommandStatus:'Applied: complete requested 