          "refId": "B",
          "query": "from(bucket: \"{{ influxdb_bucket }}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_reading\" and r.sensor_id == \"${sensor_id}\" and (r._field == \"bootNonce\" or r._field == \"msgCount\"))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => exists r.bootNonce and exists r.msgCount)\n  |> group(columns: [\"sensor_id\", \"bootNonce\"])\n  |> sort(columns: [\"_time\"])\n  |> difference(columns: [\"msgCount\"], nonNegative: true)\n  |> map(fn: (r) => ({r with _value: float(v: r.msgCount) - 1.0, _field: \"Missing packets (detected)\"}))\n  |> filter(fn: (r) => r._value > 0.0)\n  |> group(columns: [\"_start\", \"_stop\", \"_field\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: sum, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])\n  |> sort(columns: [\"_time\"])"
