        "elementValueChanged": "const recentValue = (name, maxAge) => {\n  const frame = context.panel.data.series.find(s => s.fields.some(f => f.name === name));\n  const valueField = frame?.fields.find(f => f.name === name);\n  const timeField = frame?.fields.find(f => f.type === 'time' || f.name === '_time');\n  const value = valueField?.values?.get?.(valueField.values.length-1) ?? valueField?.values?.[valueField.values.length-1];\n  const at = timeField?.values?.get?.(timeField.values.length-1) ?? timeField?.values?.[timeField.values.length-1];\n  const age = Date.now() - Number(at);\n  return Number.isFinite(age) && age >= -30000 && age <= maxAge ? value : undefined;\n};\nconst devEligible = () => recentValue('sensorOnline',300000) === true && recentValue('sensorDevMode',900000) === 1 && recentValue('gatewayFresh',300000) !== undefined;\nif (context.element?.id === 'radioPreview') return;\nconst sensor = context.grafana.templateService.replace('${sensor_id}');\nconst base = context.grafana.templateService.replace(context.panel.options.update.url).replace(/\\/config$/, '');\nconst auth = context.panel.options.update.header.find(h => h.name === 'Authorization')?.value;\nconst headers = {Authorization: auth};\nconst getPending = () => fetch(base + '/radio-transition', {headers, cache: 'no-store'}).then(r => r.ok ? r.json() : Promise.reject(Error('Transition status unavailable')));\nif (context.element?.id === 'radioRecovery') {\n  const selected = context.element.value || [];\n  context.panel.patchFormValue({radioRecovery: []});\n  if (selected.includes('refresh')) { context.panel.initialRequest(); return; }\n  if (!selected.includes('acknowledge')) return;\n  if (!window.confirm('Acknowledge the unresolved transition after following local recovery instructions? This does not confirm or resend the command.')) return;\n  context.panel.disableSubmit();\n  return getPending().then(result => {\n    if (!result.pending) return;\n    return fetch(base + '/radio-transition/' + encodeURIComponent(result.pending.commandId) + '/acknowledge', {method:'POST', headers}).then(r => {if (!r.ok) throw Error('Acknowledgement failed');});\n  }).then(() => {\n    window.dispatchEvent(new CustomEvent('lorahome-radio-transition', {detail:{sensor, pending:false}}));\n  }).catch(() => {context.panel.disableSubmit(); context.panel.patchFormValue({radioPreview:'Recovery acknowledgement failed; retry'});});\n}\ncontext.panel.disableSubmit();\nreturn getPending().then(result => {\n if (result.pending) {context.panel.patchFormValue({radioPreview:'Transition '+result.pending.status+' (ID: '+result.pending.commandId+'); refresh status or acknowledge recovery after inspection.'}); return;}\n if(!devEligible()){context.panel.patchFormValue({radioPreview:'Unavailable: Sensor must be online and confirmed in Development mode'});return;}\n\n\nconst values = context.panel.formValue();\nconst selected = [\n  Number(values.spreadingFactor),\n  Number(values.bandwidthKhz),\n  Number(values.codingRate)\n];\n\nconst bandwidths = [7.8, 10.4, 15.6, 20.8, 31.25, 41.7, 62.5, 125, 250, 500];\nconst [sf, bw, cr] = selected;\n\nif (\n  !Number.isInteger(sf) || sf < 7 || sf > 12 ||\n  !bandwidths.includes(bw) ||\n  !Number.isInteger(cr) || cr < 5 || cr > 8\n) {\n  context.panel.patchFormValue({ radioPreview: 'Select a valid profile' });\n  context.panel.disableSubmit();\n  return;\n}\n\nconst air = (bytes, profile) => {\n  const [s, b, c] = profile;\n  const t = Math.pow(2, s) / (b * 1000);\n  const de = t >= 0.016 ? 1 : 0;\n  const symbols = 8 + Math.max(\n    Math.ceil((8 * bytes - 4 * s + 44) / (4 * (s - 2 * de))) * c,\n    0\n  );\n  return (12.25 + symbols) * t;\n};\n\nconst op = air(34, selected);\nconst dev = air(45, selected);\nconst ack = air(10, selected);\nconst minOp = Math.max(10, Math.ceil(99 * Math.max(op, ack)));\nconst minDev = Math.max(10, Math.ceil(99 * Math.max(dev, ack)));\n\nif (minOp > 255 || minDev > 255) {\n  context.panel.patchFormValue({\n    radioPreview: 'Unsupported: minimum sleep exceeds 255 s'\n  });\n  context.panel.disableSubmit();\n  return;\n}\n\nconst fields = context.panel.data.series.flatMap(s => s.fields);\nconst field = name => {\n  const f = fields.find(x => x.name === name);\n  return f?.values?.get?.(f.values.length - 1)\n    ?? f?.values?.[f.values.length - 1];\n};\n\nlet comparison = 'estimated radio airtime change: N/A; estimated TX consumption: N/A';\nconst current = field('radio_available') === true\n  ? [\n    field('radio_spreading_factor'),\n    field('radio_bandwidth_khz'),\n    field('radio_coding_rate')\n  ]\n  : null;\n\nconst baselineTime = Number(field('_time'));\nconst baselineLabel = Number.isFinite(baselineTime) && baselineTime > 0 ? `last reported ${new Date(baselineTime).toLocaleString()}${Date.now()-baselineTime>300000?' (stale)':''}` : 'report time unavailable';\nif (current?.every(Number.isFinite)) {\n  const ratios = [op / air(34, current), dev / air(45, current)];\n  const pct = ratios.map(r => {\n    const change = Math.round((r - 1) * 100);\n    return `${change >= 0 ? '+' : ''}${change}%`;\n  }).join('/');\n  const multiplier = ratios.map(r => `x${Number(r.toFixed(2))}`).join('/');\n\n  comparison = `estimated radio airtime change: ${pct}; estimated TX consumption: ${multiplier}`;\n}\n\ncontext.panel.patchFormValue({\n  radioPreview: `Minimum sleep: ${minOp}/${minDev} s; ${comparison} (Operation/Development); baseline ${baselineLabel}.`\n});\ncontext.panel.enableSubmit();\n}).catch(() => {context.panel.disableSubmit();context.panel.patchFormValue({radioPreview:'Transition status unavailable; retry before submitting'});});",
