          "code": "const recentValue = (name, maxAge) => {\n  const frame = context.panel.data.series.find(s => s.fields.some(f => f.name === name));\n  const valueField = frame?.fields.find(f => f.name === name);\n  const timeField = frame?.fields.find(f => f.type === 'time' || f.name === '_time');\n  const value = valueField?.values?.get?.(valueField.values.length-1) ?? valueField?.values?.[valueField.values.length-1];\n  const at = timeField?.values?.get?.(timeField.values.length-1) ?? timeField?.values?.[timeField.values.length-1];\n  const age = Date.now() - Number(at);\n  return Number.isFinite(age) && age >= -30000 && age <= maxAge ? value : undefined;\n};\nconst devEligible = () => recentValue('sensorOnline',300000) === true && recentValue('sensorDevMode',900000) === 1 && recentValue('gatewayFresh',300000) !== undefined;\nconst sensor = context.grafana.templateService.replace('${sensor_id}');\nconst base = context.grafana.templateService.replace(context.panel.options.update.url).replace(/\\/config$/, '');\nconst auth = context.panel.options.update.header.find(h => h.name === 'Authorization')?.value;\nconst headers = {Authorization: auth};\nconst getPending = () => fetch(base + '/radio-transition', {headers, cache: 'no-store'}).then(r => r.ok ? r.json() : Promise.reject(Error('Transition status unavailable')));\nconst timerKey = '__lorahomeRadioTimer' + \"8\";\nconst dashboardPath = window.location.pathname;\nconst stopPolling = () => { if (window[timerKey]) {window.clearInterval(window[timerKey]); delete window[timerKey];} };\nstopPolling();\nconst startPolling = () => {\n  if (window[timerKey]) return;\n  let checking = false;\n  window[timerKey] = window.setInterval(() => {\n    if (window.location.pathname !== dashboardPath) {stopPolling(); return;}\n    if (checking || document.visibilityState === 'hidden') return;\n    checking = true;\n    getPending().then(result => {\n      if (!result.pending) {\n        stopPolling();\n        window.dispatchEvent(new CustomEvent('lorahome-radio-transition', {detail:{sensor, pending:false}}));\n      } else context.panel.patchFormValue({radioPreview:'Transition ' + result.pending.status + ' (ID: ' + result.pending.commandId + '); waiting for confirmation.'});\n    }).catch(() => {}).finally(() => {checking = false;});\n  }, 5000);\n};\nconst listenerKey = '__lorahomeRadioListener' + \"8\";\nif (window[listenerKey]) window.removeEventListener('lorahome-radio-transition', window[listenerKey]);\nwindow[listenerKey] = event => {\n  if (event.detail?.sensor !== sensor) return;\n  if (event.detail.pending) {\n    context.panel.disableSubmit();\n    context.panel.patchFormValue({radioPreview: 'Radio transition pending; refresh status or acknowledge recovery after inspection.'});\n    startPolling();\n  } else {stopPolling(); context.panel.initialRequest();}\n};\nwindow.addEventListener('lorahome-radio-transition', window[listenerKey]);\nconst fields = context.panel.data.series.flatMap(s => s.fields);\nconst field = name => { const f = fields.find(x => x.name === name); return f?.values?.get?.(f.values.length-1) ?? f?.values?.[f.values.length-1]; };\nconst sf=field('radio_spreading_factor'), bw=field('radio_bandwidth_khz'), cr=field('radio_coding_rate'), at=field('_time');\nconst valid = field('radio_available') === true && [sf,bw,cr].every(Number.isFinite);\ncontext.panel.disableSubmit();\nreturn getPending().then(result => {\n  if (result.pending) {\n    startPolling();\n    context.panel.patchFormValue({radioPreview: 'Transition ' + result.pending.status + ' (ID: ' + result.pending.commandId + '); refresh status or acknowledge recovery after inspection.'});\n    return;\n  }\n  if (!devEligible()) {context.panel.patchFormValue({radioPreview:'Unavailable: Sensor must be online and confirmed in Development mode'});return;}\n  const timestamp = Number.isFinite(Number(at)) ? new Date(Number(at)).toLocaleString() + (Date.now() - Number(at) > 300000 ? ' (stale)' : '') : 'time unavailable';\n  context.panel.patchFormValue({radioPreview: valid ? `Last reported: SF${sf} / BW${bw} / CR4/${cr} (${timestamp})` : 'Last reported profile: N/A'});\n  context.panel.enableSubmit();\n}).catch(() => { context.panel.disableSubmit(); startPolling(); context.panel.patchFormValue({radioPreview:'Transition status unavailable; retry before submitting'}); });",
