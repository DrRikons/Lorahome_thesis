Number(observedAt) > Date.parse(result.createdAt)\r\n    ) {\r\n      localStorage.removeItem(key);\r\n      context.panel.patchFormValue({ timeoutStatus: 'Setting saved; applies on next ON' });\r\n      context.panel.enableSubmit();\r\n      context.grafana.notifySuccess([\r\n        'Failsafe timeout',\r\n        'Gateway saved the timeout; it applies on the next ON command'\r\n      ]);\r\n      return;\r\n    }\r\n\r\n    context.panel.patchFormValue({\r\n      timeoutStatus: result.status === 'applied'\r\n        ? 'Awaiting fresh Gateway setting'\r\n        : Date.now() - Date.parse(result.createdAt) > 300000 ? 'Confirmation unavailable; inspect Gateway setting' : 'Pending: ' + result.status\r\n    });\r\n  })\r\n  .catch(() => context.panel.patchFormValue({\r\n    timeoutStatus: 'Command status unavailable'\r\n  }));",
