          "code": "const response = context.panel.response; if (!response) { context.grafana.notifyError(['Boiler relay', 'Request failed']); return; }\nconst target = context.panel.elements.find(e => e.id === 'relayClosed')?.value;\nreturn response.clone().json().then(body => {\n  if (!response.ok) { context.grafana.notifyError(['Boiler relay', JSON.stringify(body)]); return; }\n  const gateway = context.grafana.templateService.replace('${gateway_id}'); localStorage.setItem('lorahome-relay-command:' + gateway, JSON.stringify({ id: body.commandId, target, issuedAt: Date.now() }));\n  context.panel.disableSubmit(); context.panel.patchFormValue({ relayClosed: '', relayPending: 'Pending: published' }); context.grafana.notifyWarning(['Boiler relay', 'Command sent; awaiting contact feedback. ID: ' + body.commandId]);\n}).catch(() => context.grafana.notifyError(['Boiler relay', 'Invalid response']));",
