        "initial": {
          "code": "const gateway=context.grafana.templateService.replace('${gateway_id}');const key='lorahome-relay-command:'+gateway;const raw=localStorage.getItem(key);\nconst frame=context.panel.data.series.find(s=>s.refId==='B');const field=frame?.fields.find(f=>f.name==='relayClosed');const observed=field?.values?.get?.(field.values.length-1)??field?.values?.[field.values.length-1];const failure=frame?.fields.find(f=>f.name==='relayFailed');const failed=failure?.values?.get?.(failure.values.length-1)??failure?.values?.[failure.values.length-1];const time=frame?.fields.find(f=>f.type==='time');const observedAt=time?.values?.get?.(time.values.length-1)??time?.values?.[time.values.length-1];\nif(!raw){if(!['ON','OFF'].includes(observed)){context.panel.patchFormValue({relayClosed:'',relayPending:'Feedback unavailable or inconsistent'});context.panel.disableSubmit();}else {context.panel.patchFormValue({relayClosed:observed,relayPending:failed===true?'Relay failed; inspect feedback before retry':'No command pending'});context.panel.enableSubmit?.();}return;}\nlet pending;try{pending=JSON.parse(raw)}catch{localStorage.removeItem(key);return;}\n\nconst base=context.grafana.templateService.replace(context.panel.options.update.url);const auth=context.panel.options.update.header.find(h=>h.name==='Authorization')?.value;\nreturn fetch(base+'/commands/'+encodeURIComponent(pending.id),{headers:{Authorization:auth},cache:'no-store'}).then(r=>r.ok?r.json():Promise.reject(Error('Command status unavailable'))).then(result=>{\nif(result.status==='applied'&&observed===pending.target&&Number(observedAt)>Date.parse(result.createdAt)){localStorage.removeItem(key);context.panel.patchFormValue({relayClosed:observed,relayPending:'Confirmed by measured contact'});context.panel.enableSubmit?.();return;}\nif(['failed','rejected','superseded'].includes(result.status)){localStorage.removeItem(key);context.panel.patchFormValue({relayPending:'Command '+result.status});context.panel.disableSubmit();return;}\ncontext.panel.patchFormValue({relayClosed:'',relayPending:result.status==='applied'?'Awaiting fresh measured contact':Date.now()-Date.parse(result.createdAt)>300000?'Confirmation unavailable; inspect measured contact':'Pending: '+result.status});context.panel.disableSubmit();\n}).catch(()=>{context.panel.patchFormValue({relayClosed:'',relayPending:'Command status unavailable; awaiting contact'});context.panel.disableSubmit();});",
