apiVersion: 1

datasources:
  - name: LoRaHome InfluxDB
    uid: lorahome-influxdb
    type: influxdb
    access: proxy
    url: http://influxdb:8086
    jsonData:
      version: Flux
      organization: {{ influxdb_org | to_json }}
      defaultBucket: {{ influxdb_bucket | to_json }}
    secureJsonData:
      token: {{ influxdb_admin_token | to_json }}
